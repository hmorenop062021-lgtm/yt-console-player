# Cleanup on exit: kill any orphan mpv we started
# Limpieza global al salir: temporales + inhibidor + mpv
_TMP_FILES=()
reg_tmp() { _TMP_FILES+=("$1"); }
cleanup() {
    local f
    if (( ${#_TMP_FILES[@]} > 0 )); then
        for f in "${_TMP_FILES[@]}"; do
            [[ -n "$f" ]] && rm -f "$f"
        done
    fi
    stop_inhibit
    _kill_mpv /tmp/mpv-ytm.sock 2>/dev/null || true
    rm -f /tmp/mpv-ytm.sock.pid
}
trap cleanup EXIT

# Poda de JSON de búsquedas/playlists por edad y tope de tamaño
prune_search_cache() {
    local dir="$1" now f age total_kb max_mb
    [[ -d "$dir" ]] || return 0
    now=$(date +%s)

    while IFS= read -r -d '' f; do
        age=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo "$now") ))
        [[ "$age" -le "$SEARCH_CACHE_TTL" ]] || rm -f "$f"
    done < <(find "$dir" -maxdepth 1 -type f -name '*.json' ! -name 'playlist_*.json' -print0 2>/dev/null)

    while IFS= read -r -d '' f; do
        age=$(( now - $(stat -c %Y "$f" 2>/dev/null || echo "$now") ))
        [[ "$age" -le "$PLAYLIST_CACHE_TTL" ]] || rm -f "$f"
    done < <(find "$dir" -maxdepth 1 -type f -name 'playlist_*.json' -print0 2>/dev/null)

    max_mb="${CACHE_MAX_MB:-200}"
    [[ "$max_mb" -gt 0 ]] || return 0
    total_kb=$(du -sk "$dir" 2>/dev/null | awk '{print $1}')
    if [[ "${total_kb:-0}" -gt $(( max_mb * 1024 )) ]]; then
        while IFS= read -r f; do
            [[ -f "$f" ]] || continue
            rm -f "$f"
            total_kb=$(du -sk "$dir" 2>/dev/null | awk '{print $1}')
            [[ "${total_kb:-0}" -le $(( max_mb * 1024 )) ]] && break
        done < <(find "$dir" -maxdepth 1 -type f -name '*.json' -printf '%T@ %p\n' 2>/dev/null | sort -n | cut -d' ' -f2-)
    fi
}

# Recorta mpv.log al último MB configurado
rotate_mpv_log() {
    local max="${MPV_LOG_MAX_BYTES:-1048576}" size
    [[ -f "$MPV_LOG" ]] || return 0
    size=$(stat -c %s "$MPV_LOG" 2>/dev/null || echo 0)
    [[ "${size:-0}" -gt "$max" ]] || return 0
    tail -c "$max" "$MPV_LOG" > "$MPV_LOG.tmp" 2>/dev/null && mv "$MPV_LOG.tmp" "$MPV_LOG" || rm -f "$MPV_LOG.tmp"
}

prune_search_cache "$CACHE_DIR"
rotate_mpv_log
log_event "START" "ytm v$VERSION launched"

[[ "$CLEAR_CACHE" == "1" ]] && clear_search_cache
if [[ "$OPEN_FAVORITES" == "1" ]]; then
    show_favorites || true
    SEARCH_QUERY=()
fi

if [[ ${#SEARCH_QUERY[@]} -gt 0 && "$YTM_MODE" != "auto" ]]; then
    SEARCH_TYPE="$YTM_MODE"
fi

while true; do
    # Si no hay búsqueda pendiente, pedir modo + consulta con el menú
    if [[ ${#SEARCH_QUERY[@]} -eq 0 ]]; then
        show_mode_menu
        [[ ${#SEARCH_QUERY[@]} -eq 0 ]] && continue
    fi

    query="${SEARCH_QUERY[*]}"
    set +e
    do_search "$query" "$SEARCH_TYPE"
    rc=$?
    set -e
    SEARCH_QUERY=()

    # rc 10-13 = el control pidió otra búsqueda (teclas s/m/a/l) -> pedir consulta
    if (( rc >= EXIT_SEARCH_SONGS && rc <= EXIT_SEARCH_PLAYLISTS )); then
        prompt_for_type "$rc" || true
        continue
    fi

    # rc 0 = usuario salió de reproducción -> volver al menú
    # rc ≠ 0 = error de mpv/conexión -> salir de ytm
    if [[ "$rc" -ne 0 ]]; then
        exit "$rc"
    fi
done
