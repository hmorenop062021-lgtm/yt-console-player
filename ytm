# ── Historial ──────────────────────────────────────────────────
save_history() {
    local query="$1" tmp="$HISTORY_FILE.tmp"
    if [[ -f "$HISTORY_FILE" ]]; then
        while IFS='|' read -r ts q; do
            q="${q# }"
            [[ "$q" != "$query" ]] && echo "${ts}| ${q}"
        done < "$HISTORY_FILE" > "$tmp"
    fi
    echo "$(date '+%Y-%m-%d %H:%M') | $query" >> "$tmp"
    tail -n "$HISTORY_MAX" "$tmp" > "$HISTORY_FILE" 2>/dev/null
    rm -f "$tmp"
}

pick_from_history() {
    [[ ! -f "$HISTORY_FILE" || ! -s "$HISTORY_FILE" ]] && { echo "📭 No hay historial aún."; return 1; }
    local hist_data key selected line query_to_delete
    hist_data=$(mktemp)
    reg_tmp "$hist_data"

    tac "$HISTORY_FILE" | while IFS='|' read -r ts q; do
        echo -e "${q# } \t${ts# }"
    done > "$hist_data"

    selected=$( \
        "$FZF" --height=~50% --border=rounded < "$hist_data" \
               --header=" 📖 Historial | Enter=buscar, Ctrl-d=eliminar " \
               --with-nth=1 --delimiter=$'\t' \
               --preview-window=hidden \
               --expect=ctrl-d) || { rm -f "$hist_data"; return 1; }

    rm -f "$hist_data"
    key=$(echo "$selected" | head -1)
    line=$(echo "$selected" | tail -1)
    [[ -z "$line" ]] && return 1

    if [[ "$key" == "ctrl-d" ]]; then
        query_to_delete=$(echo "$line" | cut -f1)
        local tmp="$HISTORY_FILE.tmp"
        while IFS='|' read -r ts q; do
            q="${q# }"
            [[ "$q" != "$query_to_delete" ]] && echo "${ts}| ${q}"
        done < "$HISTORY_FILE" > "$tmp"
        mv "$tmp" "$HISTORY_FILE" 2>/dev/null
        echo "🗑️  Eliminado: $query_to_delete"
        pick_from_history; return $?
    fi
    echo "$line" | cut -f1
}

# ── Favoritos ──────────────────────────────────────────────────
show_favorites() {
    if [[ ! -f "$FAVORITES_FILE" || ! -s "$FAVORITES_FILE" ]]; then
        echo -e "\n  ${BYLW}⭐ No hay favoritos aún.${R}"
        echo -e "  ${D}Añade con la tecla [f] durante la reproducción.${R}\n"
        return 1
    fi
    local fav_data selected key lines
    fav_data=$(mktemp)
    reg_tmp "$fav_data"
    cp "$FAVORITES_FILE" "$fav_data"
    while :; do
        selected=$( \
            "$FZF" --height=~60% --border=rounded < "$fav_data" \
                   --header=" ⭐ Favoritos | Enter=reproducir, Ctrl-d=quitar " \
                   --with-nth=2 --delimiter=$'\t' \
                   --preview-window=hidden \
                   --expect=ctrl-d --multi) || { rm -f "$fav_data"; return 0; }
        key=$(echo "$selected" | head -1)
        lines=$(echo "$selected" | tail -n +2)
        if [[ "$key" == "ctrl-d" ]]; then
            local ids tmp="$FAVORITES_FILE.tmp"
            ids=$(echo "$lines" | cut -f1)
            [[ -z "$ids" ]] && continue
            : > "$tmp"
            while IFS=$'\t' read -r fid ftitle; do
                echo "$ids" | grep -qxF "$fid" || printf '%s\t%s\n' "$fid" "$ftitle"
            done < "$FAVORITES_FILE" > "$tmp"
            mv "$tmp" "$FAVORITES_FILE"
            cp "$FAVORITES_FILE" "$fav_data"
            echo -e "  ${BGRN}🗑️  Quitado de favoritos.${R}"
            [[ -s "$fav_data" ]] || { rm -f "$fav_data"; return 0; }
            continue
        fi
        break
    done
    rm -f "$fav_data"
    [[ -z "$lines" ]] && return 0
    process_selection "$lines" 0 "Favoritos"
    return $?
}

clear_search_cache() {
    local n
    n=$(find "$CACHE_DIR" -maxdepth 1 \( -name '*.json' -o -name 'playlist_*.json' \) 2>/dev/null | wc -l)
    find "$CACHE_DIR" -maxdepth 1 -name '*.json' -delete 2>/dev/null || true
    echo -e "  ${BGRN}🧹 Caché de búsquedas/álbumes borrada ($n archivos).${R}"
    log_event "CACHE_CLEAR" "removed=$n"
}

# ── Kill any running mpv by socket + PID ───────────────────────
_kill_mpv() {
    local sock="$1"
    # Kill via IPC socket
    if [[ -S "$sock" ]]; then
        python3 -c "
import socket, json
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(0.2)
    s.connect('$sock')
    s.sendall((json.dumps({'command': ['quit']}) + '\n').encode())
    s.close()
except: pass
" 2>/dev/null || true
        sleep 0.1
    fi
    # Also kill any orphan mpv on this socket by PID file
    local mpv_pid_file="${sock}.pid"
    if [[ -f "$mpv_pid_file" ]]; then
        kill "$(cat "$mpv_pid_file")" 2>/dev/null || true
        rm -f "$mpv_pid_file"
    fi
    # Nuclear option: kill any mpv using our socket
    pkill -f "input-ipc-server=$sock" 2>/dev/null; true
    rm -f "$sock"
}

# ── Process selection / play ───────────────────────────────────
process_selection() {
    local selected="$1"
    local start_idx="${2:-0}"
    local label="${3:-}"
    local sock_file="/tmp/mpv-ytm.sock"

    # Always kill any existing mpv before starting new one
    _kill_mpv "$sock_file"
    rm -f "$sock_file"

    local selected_count
    selected_count=$(echo "$selected" | grep -v '^[[:space:]]*$' | wc -l)
    if [[ "$selected_count" -eq 1 && "$start_idx" -eq 0 ]]; then
        local first_item
        first_item=$(echo "$selected" | cut -f1)
        # Si es un álbum/playlist URL, navegar directamente
        if [[ "$first_item" =~ (playlist\?list=|list=|/album/) ]]; then
            local album_label
            album_label=$(echo "$selected" | head -1 | cut -f2- | sed 's/ \[[^]]*\]$//')
            browse_playlist "$first_item" "$album_label"; return $?
        fi
    fi

    local lines=()
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue; lines+=("$line")
    done <<< "$selected"
    local num_lines=${#lines[@]}
    [[ "$num_lines" -eq 0 ]] && return 0
    [[ "$start_idx" -lt 0 || "$start_idx" -ge "$num_lines" ]] && start_idx=0

    local cache_fmt="bestaudio/best"

    # Pre-download starting track
    local start_cached=""
    if [[ "$DOWNLOAD" == "0" ]]; then
        local start_vid
        start_vid=$(echo "${lines[$start_idx]}" | cut -f1)
        local start_url
        if [[ "$start_vid" =~ ^https?:// ]]; then start_url="$start_vid"
        else start_url="https://youtube.com/watch?v=$start_vid"; fi

        start_cached=$(get_cached_file "$start_url") || start_cached=""
        if [[ -z "$start_cached" ]]; then
            local start_title
            start_title=$(echo "${lines[$start_idx]}" | cut -f2- | sed 's/ \[.*//')
            [[ -z "$start_title" ]] && start_title="$start_url"
            echo -e "  ${BCYN}⏳ Descargando:${R} ${B}$start_title${R}"
            if timeout 10 "$YT_DLP" -f "$cache_fmt" --no-playlist -o "$CACHE_MEDIA_DIR/%(id)s.webm" "$start_url" >/dev/null 2>&1; then
                start_cached=$(get_cached_file "$start_url") || start_cached=""; prune_cache
            else
                echo -e "  ${BYLW}⚠️  Streaming directo...${R}"
            fi
        fi
    fi

    # Build URL list
    local urls=()
    for ((i=0; i<num_lines; i++)); do
        local vid
        vid=$(echo "${lines[$i]}" | cut -f1)
        [[ -z "$vid" || "$vid" == "?" ]] && continue
        local url
        if [[ "$vid" =~ ^https?:// ]]; then url="$vid"
        else url="https://youtube.com/watch?v=$vid"; fi

        if [[ "$DOWNLOAD" == "1" ]]; then
            local title
            title=$(echo "${lines[$i]}" | cut -f2- | sed 's/ \[.*//')
            [[ -z "$title" ]] && title="$url"
            echo -e "  ${BCYN}🡇 Descargando:${R} $title"
            "$YT_DLP" -f "$FORMAT" --embed-thumbnail --add-metadata \
                -o "$DOWNLOAD_DIR/%(title)s.%(ext)s" "$url" 2>&1 | \
                while IFS= read -r ln; do
                    [[ "$ln" =~ ^\[download] || "$ln" =~ ^\[Extract] || "$ln" =~ ^\[Merger] ]] && echo "    $ln"
                done
        else
            if [[ "$i" -eq "$start_idx" && -n "$start_cached" ]]; then
                urls+=("$start_cached")
            else
                local cached
                cached=$(get_cached_file "$url") || cached=""
                urls+=("${cached:-$url}")
            fi
        fi
    done

    if [[ "$DOWNLOAD" == "1" ]]; then
        echo -e "  ${BGRN}✅ Completado.${R}"; return 0
    fi
    [[ ${#urls[@]} -eq 0 ]] && return 0

    # Limitar a N canciones (-c) si se especificó (0 = todas)
    if [[ "${PLAY_COUNT:-0}" -gt 0 && "${#urls[@]}" -gt $(( start_idx + PLAY_COUNT )) ]]; then
        urls=("${urls[@]:0:$(( start_idx + PLAY_COUNT ))}")
    fi

    # Background cache next tracks (only 2 tracks to avoid bandwidth saturation)
    if [[ "$num_lines" -gt 1 ]]; then
        (
            local max_preload=2
            local count=0
            local offset
            for ((offset=1; offset<num_lines && count<max_preload; offset++)); do
                local idx=$(( (start_idx + offset) % num_lines ))
                local vid
                vid=$(echo "${lines[$idx]}" | cut -f1)
                local url="https://youtube.com/watch?v=$vid"
                local cached
                cached=$(get_cached_file "$url") || cached=""
                if [[ -z "$cached" ]]; then
                    count=$((count + 1))
                    timeout 12 "$YT_DLP" -f "$cache_fmt" --no-playlist \
                        -o "$CACHE_MEDIA_DIR/%(id)s.webm" "$url" >/dev/null 2>&1 || true
                    prune_cache
                fi
            done
        ) & disown
    fi

    # Launch mpv
    local mpv_args=(
        --input-ipc-server="$sock_file"
        --cache=yes --demuxer-max-bytes=${MPV_CACHE_MB}M --demuxer-max-back-bytes=${MPV_CACHE_BACK_MB}M
        --demuxer-readahead-secs=120 --cache-secs=120 --prefetch-playlist=no
        --stream-buffer-size=${MPV_STREAM_BUFFER_MB}M
        --ytdl-raw-options=js-runtimes=node,remote-components=ejs:github
        --no-video --ytdl-format="bestaudio[ext=m4a]/bestaudio/best"
    )
    [[ "$start_idx" -gt 0 ]] && mpv_args+=(--playlist-start="$start_idx")
    [[ -n "$EQ_ARGS" ]] && mpv_args+=("$EQ_ARGS")
    [[ -n "$SPEED_ARGS" ]] && mpv_args+=("$SPEED_ARGS")

    log_event "MPV" "launching $PLAYER | tracks=${#urls[@]} | start_idx=$start_idx | audio=$AUDIO_ONLY"
    start_inhibit
    "$PLAYER" "${mpv_args[@]}" "${urls[@]}" >>"$MPV_LOG" 2>&1 &
    local mpv_pid=$!
    echo "$mpv_pid" > "${sock_file}.pid"
    log_event "MPV" "started pid=$mpv_pid | socket=$sock_file"

    # Run control script; on ANY exit (crash, signal, normal), clean up
    # No reactivar errexit si el llamador lo tenía desactivado: los rc 10-13
    # (buscar) se manejan en el bucle principal, no deben abortar el script.
    local had_errexit=0
    [[ $- == *e* ]] && had_errexit=1
    set +e
    export CACHE_MEDIA_DIR AUDIO_ONLY FORMAT DOWNLOAD_DIR LOG_FILE VERSION PLAYLIST_LABEL="$label"
    log_event "CONTROL" "start ytm_control v$VERSION"
    python3 "$SCRIPT_DIR/ytm_control.py" "$sock_file" "$mpv_pid" 2>>"$LOG_FILE"
    local rc=$?
    [[ "$had_errexit" == "1" ]] && set -e
    log_event "CONTROL" "exit rc=$rc"

    # Always kill mpv and clean socket
    _kill_mpv "$sock_file"
    stop_inhibit
    return $rc
}

# ── Browse playlist/album ─────────────────────────────────────
browse_playlist() {
    local url="$1"
    local label="${2:-}"
    local fzf_data playlist_cache result_count

    echo -e "  ${BCYN}📂 Cargando contenido...${R}"
    playlist_cache="$CACHE_DIR/playlist_$(echo "$url" | md5sum | cut -d' ' -f1).json"

    # Reutilizar el listado de pistas si está en caché y no se pidió refrescar
    local pl_age=-1
    [[ -f "$playlist_cache" && -s "$playlist_cache" ]] && \
        pl_age=$(( $(date +%s) - $(stat -c %Y "$playlist_cache" 2>/dev/null || echo 0) ))
    if [[ "$REFRESH" != "1" && "$pl_age" -ge 0 && "$pl_age" -le "$PLAYLIST_CACHE_TTL" ]]; then
        echo -e "  ${BCYN}📋 Caché de álbum/lista (${pl_age}s)${R}"
        log_event "PLAYLIST_CACHE" "Hit: $url | age=${pl_age}s"
    else
        "$YT_DLP" --flat-playlist --dump-json --ignore-errors "$url" 2>/dev/null > "$playlist_cache" || {
            echo "  ${BRED}❌ No se pudo cargar.${R}"; return 1
        }
    fi
    result_count=$(wc -l < "$playlist_cache" 2>/dev/null || echo 0)
    [[ "$result_count" -eq 0 ]] && { echo "  ${BRED}❌ Sin pistas.${R}"; return 1; }

    fzf_data=$(mktemp)

    reg_tmp "$fzf_data"

    $JQ -r 'def fmt_dur: if . then ((./60 | floor | tostring) + ":" + (. % 60 | tostring | if length == 1 then "0" + . else . end)) else "?" end;
       "\(.id // "?")\t\(.title // "?")  [\(.channel // .uploader // "?") - \((.duration // -1 | fmt_dur))]"' \
       "$playlist_cache" > "$fzf_data" 2>/dev/null

    local header=" 💿 Álbum/Lista ($result_count temas) | Enter=play, Alt+a=all "
    local selected
    selected=$( \
        "$FZF" "${_YTM_FZF_OPTS[@]}" < "$fzf_data" \
               --border-label=" YouTube Music " \
               --header="$header" \
               --with-nth=2.. --delimiter=$'\t' \
               --preview-window=hidden \
               --bind='alt-a:select-all,alt-d:deselect-all' \
               --multi) || { rm -f "$fzf_data"; return 0; }

    local tracks
    tracks=$(echo "$selected" | grep -v '^[[:space:]]*$')
    [[ -z "$tracks" ]] && { rm -f "$fzf_data"; return 0; }

    # ── Una sola pista → cargar el álbum completo empezando en ella ──
    local all_tracks="" start_idx=0
    local sel_count
    sel_count=$(echo "$tracks" | grep -v '^[[:space:]]*$' | wc -l)
    if [[ "$sel_count" -eq 1 ]]; then
        local selected_id line_num
        selected_id=$(echo "$tracks" | cut -f1)
        line_num=$(grep -n "^${selected_id}"$'\t' "$fzf_data" | cut -d: -f1 | head -1)
        if [[ -n "$line_num" ]]; then
            start_idx=$((line_num - 1))
            all_tracks=$(cat "$fzf_data")
            echo -e "  ${BCYN}💿 Álbum completo ($result_count pistas) — iniciando en la pista $((start_idx + 1))${R}"
        fi
    fi

    rm -f "$fzf_data"

    if [[ -n "$all_tracks" ]]; then
        process_selection "$all_tracks" "$start_idx" "$label"
    else
        process_selection "$tracks" 0 "$label"
    fi
    return $?
}

# ── Search functions ──────────────────────────────────────────
do_search() {
    local query="$1" search_type="$2"
    local cache_file="$CACHE_DIR/$(echo "$query $search_type" | md5sum | cut -d' ' -f1).json"
    local encoded_query
    encoded_query=$($JQ -rn --arg q "$query" '$q|@uri')

    # ── Caché de búsqueda: reutilizar si es menor a SEARCH_CACHE_TTL (salvo --refresh) ──
    local use_cache=0
    if [[ "$REFRESH" != "1" && -f "$cache_file" && -s "$cache_file" ]]; then
        local cache_age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0) ))
        if [[ "$cache_age" -le "$SEARCH_CACHE_TTL" ]]; then
            local result_count
            result_count=$(wc -l < "$cache_file" 2>/dev/null || echo 0)
            if [[ "$result_count" -gt 0 ]]; then
                echo -e "  ${BCYN}📋 Caché de búsqueda: \"$query\" ($search_type, ${cache_age}s)${R}"
                log_event "SEARCH_CACHE" "Hit: $query ($search_type) | age=${cache_age}s"
                use_cache=1
            fi
        fi
    fi

    if [[ "$use_cache" != "1" ]]; then
        case "$search_type" in
        songs)
            echo -e "  ${BMAG}🎵 Buscando canciones:${R} ${B}$query${R}"
            log_event "YTM_SONGS" "Query: $query | max=$MAX_RESULTS"
            "$YT_DLP" --flat-playlist --dump-json --ignore-errors \
                "ytsearch${MAX_RESULTS}:${query} audio" 2>/dev/null > "$cache_file" || {
                echo "  ${BRED}❌ Búsqueda fallida.${R}"
                log_event "ERROR" "Song search failed: $query"; return 1
            } ;;
        albums)
            echo -e "  ${BMAG}💿 Buscando álbumes:${R} ${B}$query${R}"
            log_event "YTM_ALBUMS" "Query: $query | max=$MAX_RESULTS"
            "$YT_DLP" --flat-playlist --dump-json --ignore-errors \
                "https://www.youtube.com/results?search_query=${encoded_query}+album&sp=EgIQAw%253D%253D" 2>/dev/null > "$cache_file" || {
                echo "  ${BRED}❌ Búsqueda fallida.${R}"
                log_event "ERROR" "Album search failed: $query"; return 1
            } ;;
        playlists)
            echo -e "  ${BMAG}📜 Buscando playlists:${R} ${B}$query${R}"
            log_event "YTM_PLAYLISTS" "Query: $query | max=$MAX_RESULTS"
            "$YT_DLP" --flat-playlist --dump-json --ignore-errors \
                "https://www.youtube.com/results?search_query=${encoded_query}+playlist&sp=EgIQAw%253D%253D" 2>/dev/null > "$cache_file" || {
                echo "  ${BRED}❌ Búsqueda fallida.${R}"
                log_event "ERROR" "Playlist search failed: $query"; return 1
            } ;;
    esac
    fi

    local result_count
    result_count=$(wc -l < "$cache_file" 2>/dev/null || echo 0)
    if [[ "$result_count" -eq 0 ]]; then
        echo "  ${BRED}❌ Sin resultados para: $query${R}"; return 1
    fi
    log_event "SEARCH" "Results: $result_count for \"$query\" ($search_type)"
    save_history "$query"

    if [[ "$LIST_ONLY" == "1" ]]; then
        echo ""
        echo -e "  ${BCYN}📋 Resultados: $query${R}"
        case "$search_type" in
            songs)
                $JQ -r '"  ▶ \(.title // "?")\n    👤 \(.channel // .uploader // "?")  ⏱ \(.duration_string // "?")"' \
                   "$cache_file" 2>/dev/null ;;
            *)
                $JQ -r '"  ▶ \(.title // "?")\n    👤 \(.channel // .uploader // "?")"' \
                   "$cache_file" 2>/dev/null ;;
        esac
        echo ""; exit 0
    fi

    # Interactive selection
    local fzf_data
    fzf_data=$(mktemp)
    reg_tmp "$fzf_data"

    case "$search_type" in
        songs)
            $JQ -r 'def fmt_dur: if .duration then ((.duration/60 | floor | tostring) + ":" + (.duration % 60 | tostring | if length == 1 then "0" + . else . end)) else (.duration_string // "?") end;
               "\(.id // "?")\t\(.title // "?")  [\(.channel // .uploader // "YouTube") - \(fmt_dur)]"' \
               "$cache_file" > "$fzf_data" 2>/dev/null ;;
        albums|playlists)
            $JQ -r 'select((.url // "") | contains("playlist?list=") or ((.id // "") | startswith("PL") or startswith("OLAK5uy_") or startswith("RDCLAK5uy_"))) |
               "\(.url // "https://www.youtube.com/playlist?list=" + .id)\t\(.title // "?")  [\(.channel // .uploader // "?")]"' \
               "$cache_file" > "$fzf_data" 2>/dev/null ;;
    esac

    local mode_label
    case "$search_type" in
        songs)     mode_label="🎵 Canciones" ;;
        albums)    mode_label="💿 Álbumes" ;;
        playlists) mode_label="📜 Playlists" ;;
    esac
    [[ "$DOWNLOAD" == "1" ]] && mode_label="🡇 Descarga · $mode_label"

    local header=" ${mode_label} · ${query} | Enter=play, Alt+a=all, Tab=multi "
    local selected
    selected=$( \
        "$FZF" "${_YTM_FZF_OPTS[@]}" < "$fzf_data" \
               --border-label=" YouTube Music " \
               --header="$header" \
               --with-nth=2.. --delimiter=$'\t' \
               --preview-window=hidden \
               --bind='ctrl-i:toggle-preview,?:toggle-preview' \
               --bind='alt-a:select-all,alt-d:deselect-all' \
               --multi) || { rm -f "$fzf_data"; return 0; }

    rm -f "$fzf_data"
    local tracks
    tracks=$(echo "$selected" | grep -v '^[[:space:]]*$')
    [[ -z "$tracks" ]] && return 0

    process_selection "$tracks" 0 "$query"
    return $?
}

# ── Mode menu (when no args) ─────────────────────────────────
show_mode_menu() {
    while true; do
        clear
        _draw_banner
        echo ""

        # Build mode items for fzf
        local mode_data
        mode_data=$(mktemp)
        reg_tmp "$mode_data"
        cat > "$mode_data" <<MODES
1	🎵  Canciones		Buscar y reproducir canciones
