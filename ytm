            4)
                SEARCH_TYPE="songs"
                echo -e "\n  ${BCYN}🔀 Nombre del artista:${R} "
                read -r artist_name
                [[ -z "$artist_name" ]] && continue
                SEARCH_QUERY=("$artist_name"); break ;;
