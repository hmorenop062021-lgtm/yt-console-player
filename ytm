# ── Event log ───────────────────────────────────────────────────
log_event() {
    local level="$1" message="$2"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [$level] | $message" >> "$LOG_FILE" 2>/dev/null || true
    local tmp_log="$LOG_FILE.tmp"
    tail -n "$LOG_MAX" "$LOG_FILE" > "$tmp_log" 2>/dev/null && mv "$tmp_log" "$LOG_FILE" 2>/dev/null || true
}

# Log de errores inesperados (bajo set -e)
trap 'log_event "ERROR" "unexpected error: line $LINENO | cmd: $BASH_COMMAND | rc=$?"' ERR

# ── Cache ───────────────────────────────────────────────────────
get_cached_file() {
    local url_or_id="$1"
    local id=""
    if [[ "$url_or_id" =~ ^https?:// ]]; then
        if [[ "$url_or_id" =~ v=([^&]+) ]]; then
            id="${BASH_REMATCH[1]}"
        elif [[ "$url_or_id" =~ youtu\.be/([^?]+) ]]; then
            id="${BASH_REMATCH[1]}"
        fi
    else
        id="$url_or_id"
    fi

    if [[ -n "$id" ]]; then
        local ttl=${CACHE_TTL:-86400}
        local now=$(date +%s)
        for f in "$CACHE_MEDIA_DIR/$id".*; do
            [[ -f "$f" && ! "$f" =~ \.(part|ytdl|temp)$ ]] || continue
            local mtime
            mtime=$(stat -c %Y "$f" 2>/dev/null || echo 0)
            local age=$(( now - mtime ))
            [[ "$age" -le "$ttl" ]] && echo "$f" && return 0
        done
    fi
    return 1
}

prune_cache() {
    local max_files=50
    local max_age=$(( 24 * 3600 ))
    [[ -n "$CACHE_TTL" ]] && max_age="$CACHE_TTL"
    [[ -d "$CACHE_MEDIA_DIR" ]] || return 0

    local now f mtime age
    now=$(date +%s)
    for f in "$CACHE_MEDIA_DIR"/*; do
        [[ -f "$f" ]] || continue
        mtime=$(stat -c %Y "$f" 2>/dev/null || echo "$now")
        age=$(( now - mtime ))
        [[ "$age" -le "$max_age" ]] || rm -f "$f"
    done

    local count
    count=$(find "$CACHE_MEDIA_DIR" -maxdepth 1 -type f 2>/dev/null | wc -l)
    if [[ "$count" -gt "$max_files" ]]; then
        while IFS= read -r f; do
            [[ "$count" -le "$max_files" ]] && break
            rm -f "$f"
            count=$((count - 1))
        done < <(find "$CACHE_MEDIA_DIR" -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | cut -d' ' -f2-)
    fi
}

# ── Idle inhibition ────────────────────────────────────────────
_INHIBIT_PID=
_XSET_AWAKE=0
INHIBIT_IDLE=0

start_inhibit() {
    [[ "$INHIBIT_IDLE" == "0" ]] && return
    if command -v systemd-inhibit &>/dev/null && [[ -z "${_INHIBIT_PID:-}" ]]; then
        systemd-inhibit --why="Playing music with ytm" sleep infinity &
        _INHIBIT_PID=$!; disown "$_INHIBIT_PID" 2>/dev/null || true; return
    fi
    if command -v xset &>/dev/null && [[ "$_XSET_AWAKE" == "0" ]] && [[ -n "${DISPLAY:-}" ]]; then
        _DPMS_STATE=$(xset -q 2>/dev/null | grep -i 'dpms is' | head -1)
        xset -dpms 2>/dev/null || true; xset s off 2>/dev/null || true; _XSET_AWAKE=1
    fi
}

stop_inhibit() {
    if [[ -n "${_INHIBIT_PID:-}" ]]; then
        pkill -TERM -P "$_INHIBIT_PID" 2>/dev/null || true
        kill "$_INHIBIT_PID" 2>/dev/null || true
        _INHIBIT_PID=
    fi
    if [[ "$_XSET_AWAKE" == "1" ]]; then
        if [[ "${_DPMS_STATE:-}" =~ Enabled ]]; then xset +dpms 2>/dev/null || true
        else xset -dpms 2>/dev/null || true; fi
        xset s on 2>/dev/null || true; _XSET_AWAKE=0
    fi
}

