# ── Terminal width (recalculated every render) ──────────────────
_get_cols() { tput cols 2>/dev/null || echo 80; }

# ── Wide-character length: emojis + CJK = 2 cols each ──────────
# Uses python for reliable counting since bash can't handle multi-byte.
_vis_len() {
    # Strips ANSI, then counts display width (emojis=2, CJK=2, rest=1)
    python3 -c "
import sys, unicodedata, re
s = sys.argv[1]
# strip ANSI
s = re.sub(r'\033\[[0-9;]*m', '', s)
w = 0
for ch in s:
    eaw = unicodedata.east_asian_width(ch)
    w += 2 if eaw in ('W', 'F') else 1
print(w)
" "$1" 2>/dev/null || {
        # Fallback: strip ANSI and count bytes (rough)
        local stripped
        stripped=$(echo -e "$1" | sed 's/\x1b\[[0-9;]*m//g')
        echo "${#stripped}"
    }
}

# ── Repeat char helper (no seq overhead) ───────────────────────
_repeat() {
    printf "%0.s$1" $(seq 1 "$2")
}

# ── Box drawing: center text in a box ──────────────────────────
_box_line() {
    # box_line <char> <width>
    local ch="$1" w="$2"
    printf '%s' "$ch"
    printf '%0.s' $(seq 1 $((w - 2)) 2>/dev/null)
    printf '%s' "$ch"
}

_box_center() {
    # Print: │ <centered text> │  — respects vis_len for padding
    # _box_center <text> <width> <border_color>
    local text="$1" w="${2:-$(_get_cols)}" bc="${3:-$BCYN}"
    local vlen
    vlen=$(_vis_len "$text")
    local inner=$((w - 2))  # space between │ and │
    local pad_l=$(( (inner - vlen) / 2 ))
    local pad_r=$(( inner - vlen - pad_l ))
    [[ $pad_l -lt 0 ]] && pad_l=0
    [[ $pad_r -lt 0 ]] && pad_r=0
    printf "${bc}│${R}"
    printf '%0.s ' $(seq 1 $pad_l 2>/dev/null)
    echo -ne "$text"
    printf '%0.s ' $(seq 1 $pad_r 2>/dev/null)
    printf "${bc}│${R}\n"
}

_box_blank() {
    # │<spaces>│
    local w="${1:-$(_get_cols)}" bc="${2:-$BCYN}"
    printf "${bc}│${R}"
    printf '%0.s ' $(seq 1 $((w - 2)) 2>/dev/null)
    printf "${bc}│${R}\n"
}

_box_top()    { printf "${2:-$BCYN}╭"; _repeat "─" $(( ${1:-$(_get_cols)} - 2 )); printf "╮${R}\n"; }
_box_mid()    { printf "${2:-$BCYN}├"; _repeat "─" $(( ${1:-$(_get_cols)} - 2 )); printf "┤${R}\n"; }
_box_bottom() { printf "${2:-$BCYN}╰"; _repeat "─" $(( ${1:-$(_get_cols)} - 2 )); printf "╯${R}\n"; }

# ── Full banner ────────────────────────────────────────────────
_draw_banner() {
    local w
    w=$(_get_cols)
    echo ""
    _box_top "$w" "$BCYN"
    _box_center "" "$w" "$BCYN"
    _box_center "${BMAG}${B}♪  YouTube Music Player  ♪${R}" "$w" "$BCYN"
    _box_center "${DIM}v$VERSION${R}" "$w" "$BCYN"
    _box_center "" "$w" "$BCYN"
    _box_bottom "$w" "$BCYN"
}

