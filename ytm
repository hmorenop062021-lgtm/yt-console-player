# ── Dependencias requeridas ─────────────────────────────────────
validate_dependencies() {
    local deps=("$YT_DLP_BIN" fzf mpv jq python3)
    local missing=()
    local dep
    for dep in "${deps[@]}"; do
        command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "❌ Error: Dependencias faltantes: ${missing[*]}" >&2
        echo "Por favor, instálalas antes de continuar." >&2
        exit 1
    fi
}
validate_dependencies

# ── Colores ANSI ────────────────────────────────────────────────
R='\033[0m'    B='\033[1m'    D='\033[2m'
RED='\033[31m' GRN='\033[32m' YLW='\033[33m'
BLU='\033[34m' MAG='\033[35m' CYN='\033[36m' WHT='\033[37m'
BRED='\033[1;31m' BGRN='\033[1;32m' BYLW='\033[1;33m'
