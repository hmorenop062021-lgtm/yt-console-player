download_video() {
    local url="$1"
    local title="$2"
    local format="$3"
    local dest="$4"
    local is_concurrent="${5:-0}"
    local start_time end_time elapsed ok

    mkdir -p "$dest"

    # Verificar si el archivo ya existe en caché local
    local cached_src=""
    cached_src=$(get_cached_file "$url") || cached_src=""
    if [[ -n "$cached_src" && -f "$cached_src" ]]; then
        local ext="${cached_src##*.}"
        local safe_title
        safe_title=$(echo "$title" | tr -d '/\\:*?"<>|')
        [[ -z "$safe_title" ]] && safe_title="track"
        local target="$dest/${safe_title}.${ext}"
        
        echo ""
        echo "━━━ Copiando desde caché a descargas: $title ━━━"
        if cp "$cached_src" "$target" 2>/dev/null; then
            echo "  ⚡ ¡Copiado al instante desde la caché local!"
            echo "  📁 Destino: $target"
            log_event "DOWNLOAD" "Fast copied from cache: $title -> $target"
            return 0
        fi
    fi

    local subs="${6:-}"
    local subs_args=()
    if [[ -n "$subs" ]]; then
        if [[ "$subs" == "all" ]]; then
            subs_args=(--write-subs --sub-langs all --embed-subs)
        else
            subs_args=(--write-subs --sub-langs "$subs" --embed-subs)
        fi
        log_event "DOWNLOAD" "Subtitles: $subs for $title"
    fi

    start_time=$(date +%s)
    log_event "DOWNLOAD" "Starting: $title | format=$format"

    if [[ "$is_concurrent" == "1" ]]; then
        ("$YT_DLP" -f "$format" "${subs_args[@]}" --embed-thumbnail --add-metadata \
            --newline --progress \
            -o "$dest/%(title)s.%(ext)s" "$url" > /dev/null 2>&1) &
        return 0
    else
        echo ""
        echo "━━━ Descargando: $title ━━━"
        "$YT_DLP" -f "$format" "${subs_args[@]}" --embed-thumbnail --add-metadata \
            --newline --progress \
            -o "$dest/%(title)s.%(ext)s" "$url" 2>&1 | \
            while IFS= read -r line; do
                if [[ "$line" =~ ^\[download ]] || [[ "$line" =~ ^\[Extract ]] || [[ "$line" =~ ^\[Merger ]] || [[ "$line" =~ ^\[Metadata ]] || [[ "$line" =~ ^ERROR ]]; then
                    echo "  $line"
                fi
            done
        ok=${PIPESTATUS[0]}

        end_time=$(date +%s)
        elapsed=$((end_time - start_time))

        if [[ "$ok" -eq 0 ]]; then
            echo "  ✅ Descargado en ${elapsed}s"
            log_event "DOWNLOAD" "Completed: $title | ${elapsed}s | $dest"
            return 0
        else
            echo "  ❌ Error en descarga (código $ok)"
            log_event "ERROR" "Download failed: $title | exit=$ok"
            return 1
        fi
    fi
}

save_history() {
    local query="$1"
    local tmp="$HISTORY_FILE.tmp"
    if [[ -f "$HISTORY_FILE" ]]; then
        while IFS='|' read -r ts q; do
            q="${q# }"
            [[ "$q" != "$query" ]] && echo "${ts}| ${q}"
        done < "$HISTORY_FILE" > "$tmp"
    fi
    echo "$(date '+%Y-%m-%d %H:%M') | $query" >> "$tmp"
    tail -n "$HISTORY_MAX" "$tmp" > "$HISTORY_FILE" 2>/dev/null
    rm -f "$tmp"
}

pick_from_history() {
    if [[ ! -f "$HISTORY_FILE" || ! -s "$HISTORY_FILE" ]]; then
        echo "📭 No hay historial de búsquedas aún."
        return 1
    fi

    local hist_data selected key line query_to_delete
    hist_data=$(mktemp)
    reg_tmp "$hist_data"

    tac "$HISTORY_FILE" | while IFS=' | ' read -r ts q; do
        echo -e "$q\t$ts"
    done > "$hist_data"

    selected=$( \
        "$FZF" --height=~60% --border=double < "$hist_data" \
               --header="📜 Historial de búsqueda  |  Enter=buscar, Ctrl-d=eliminar, Esc=cancelar" \
               --with-nth=1 --delimiter=$'\t' \
               --preview='echo "🔍 {}" | cut -f1' \
               --preview-window=hidden \
               --bind='ctrl-i:toggle-preview,?:toggle-preview' \
               --expect=ctrl-d) || { rm -f "$hist_data"; return 1; }

    rm -f "$hist_data"

    key=$(echo "$selected" | head -1)
    line=$(echo "$selected" | tail -1)

    if [[ -z "$line" ]]; then
        return 1
    fi

    if [[ "$key" == "ctrl-d" ]]; then
        query_to_delete=$(echo "$line" | cut -f1)
        local tmp="$HISTORY_FILE.tmp"
        while IFS='|' read -r ts q; do
            q="${q# }"
            [[ "$q" != "$query_to_delete" ]] && echo "${ts}| ${q}"
        done < "$HISTORY_FILE" > "$tmp"
        mv "$tmp" "$HISTORY_FILE" 2>/dev/null
        echo "🗑️  Eliminado: $query_to_delete"
        log_event "HISTORY" "Deleted: $query_to_delete"
        pick_from_history
        return $?
    fi

    echo "$line" | cut -f1
}

# ── Favoritos ──────────────────────────────────────────────────
show_favorites() {
    if [[ ! -f "$FAVORITES_FILE" || ! -s "$FAVORITES_FILE" ]]; then
        echo ""
        echo "⭐ No hay favoritos aún."
        echo "   Añade con la tecla [f] durante la reproducción."
        return 1
    fi
    local fav_data selected key lines
    fav_data=$(mktemp)
    reg_tmp "$fav_data"
    cp "$FAVORITES_FILE" "$fav_data"
    while :; do
        selected=$( \
            "$FZF" --height=~60% --border=rounded < "$fav_data" \
                   --header=" ⭐ Favoritos | Enter=reproducir, Ctrl-d=quitar " \
                   --with-nth=2 --delimiter=$'\t' \
                   --preview-window=hidden \
                   --expect=ctrl-d --multi) || { rm -f "$fav_data"; return 0; }
        key=$(echo "$selected" | head -1)
        lines=$(echo "$selected" | tail -n +2)
        if [[ "$key" == "ctrl-d" ]]; then
            local ids tmp="$FAVORITES_FILE.tmp"
            ids=$(echo "$lines" | cut -f1)
            [[ -z "$ids" ]] && continue
            : > "$tmp"
            while IFS=$'\t' read -r fid ftitle; do
                echo "$ids" | grep -qxF "$fid" || printf '%s\t%s\n' "$fid" "$ftitle"
            done < "$FAVORITES_FILE" > "$tmp"
            mv "$tmp" "$FAVORITES_FILE"
            cp "$FAVORITES_FILE" "$fav_data"
            echo "🗑️  Quitado de favoritos."
            log_event "FAVORITE" "removed: $(echo "$ids" | tr '\n' ' ')"
            [[ -s "$fav_data" ]] || { rm -f "$fav_data"; return 0; }
            continue
        fi
        break
    done
    rm -f "$fav_data"
    [[ -z "$lines" ]] && return 0
    process_selection "$lines" 0 "Favoritos"
    return $?
}

clear_search_cache() {
    local n
    n=$(find "$CACHE_DIR" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l)
    find "$CACHE_DIR" -maxdepth 1 -name '*.json' -delete 2>/dev/null || true
    echo "🧹 Caché de búsquedas/álbumes borrada ($n archivos)."
    log_event "CACHE_CLEAR" "removed=$n"
}

_kill_mpv() {
    local sock="$1"
    if [[ -S "$sock" ]]; then
        python3 -c "
import socket, json
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(0.2)
    s.connect('$sock')
    s.sendall((json.dumps({'command': ['quit']}) + '\n').encode())
    s.close()
except: pass
" 2>/dev/null || true
        sleep 0.1
    fi
    local mpv_pid_file="${sock}.pid"
    if [[ -f "$mpv_pid_file" ]]; then
        local p
        p=$(cat "$mpv_pid_file" 2>/dev/null || echo "")
        [[ -n "$p" ]] && kill "$p" 2>/dev/null || true
        rm -f "$mpv_pid_file"
    fi
    pkill -f "input-ipc-server=$sock" 2>/dev/null || true
    rm -f "$sock"
}

