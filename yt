# ---- Event log ----
log_event() {
    local level="$1"
    local message="$2"
    local tmp_log
    echo "$(date '+%Y-%m-%d %H:%M:%S') [$level] | $message" >> "$LOG_FILE" 2>/dev/null || true
    # Trim log to keep last LOG_MAX entries
    tmp_log="$LOG_FILE.tmp"
    tail -n "$LOG_MAX" "$LOG_FILE" > "$tmp_log" 2>/dev/null && mv "$tmp_log" "$LOG_FILE" 2>/dev/null || true
}

# Log de errores inesperados (bajo set -e)
trap 'log_event "ERROR" "unexpected error: line $LINENO | cmd: $BASH_COMMAND | rc=$?"' ERR

show_manual() {
    local manual="$MANUAL_FILE"
    if [[ ! -f "$manual" ]]; then
        echo "📭 Manual no encontrado en $manual"
        exit 1
    fi
    if command -v xdg-open &>/dev/null; then
        xdg-open "$manual" 2>/dev/null || sensible-browser "$manual" 2>/dev/null || {
            echo "📖 Manual: $manual"
            echo "💡 Ábrelo manualmente en tu navegador."
        }
    else
        echo "📖 Manual: $manual"
    fi
    exit 0
}

show_log() {
    if [[ ! -f "$LOG_FILE" || ! -s "$LOG_FILE" ]]; then
        echo "📭 No hay eventos registrados aún."
        exit 0
    fi
    
    local filter="${1:-}"
    local show_tail="${2:-0}"
    
    if [[ "$show_tail" == "1" ]]; then
        if [[ -n "$filter" ]]; then
            grep -i "$filter" "$LOG_FILE" | tail -10 || echo "🔍 No hay eventos que coincidan con \"$filter\""
        else
            tail -10 "$LOG_FILE"
        fi
    elif [[ -n "$filter" ]]; then
        grep -i "$filter" "$LOG_FILE" || echo "🔍 No hay eventos que coincidan con \"$filter\""
    else
        if command -v less &>/dev/null; then
            less "$LOG_FILE"
        else
            cat "$LOG_FILE"
        fi
    fi
    exit 0
}

# ---- Format presets ----
resolve_format() {
    local fmt="$1"
    case "${fmt,,}" in
        best)          echo "bestvideo+bestaudio/best" ;;
        audio|mp3)     echo "bestaudio/best" ;;
        mp4)           echo "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]" ;;
        webm)          echo "bestvideo[ext=webm]+bestaudio[ext=webm]/best[ext=webm]" ;;
        144|144p)      echo "bestvideo[height<=144]+bestaudio/best[height<=144]" ;;
        240|240p)      echo "bestvideo[height<=240]+bestaudio/best[height<=240]" ;;
        360|360p)      echo "bestvideo[height<=360]+bestaudio/best[height<=360]" ;;
        480|480p)      echo "bestvideo[height<=480]+bestaudio/best[height<=480]" ;;
        720|720p)      echo "bestvideo[height<=720]+bestaudio/best[height<=720]" ;;
        1080|1080p)    echo "bestvideo[height<=1080]+bestaudio/best[height<=1080]" ;;
        1440|1440p|2k) echo "bestvideo[height<=1440]+bestaudio/best[height<=1440]" ;;
        2160|2160p|4k) echo "bestvideo[height<=2160]+bestaudio/best[height<=2160]" ;;
        *)             echo "$fmt" ;;
    esac
}

