# ---- Dependency validation ----
validate_dependencies() {
    local deps=("yt-dlp" "fzf" "mpv" "jq" "bc")
    local missing=()
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            missing+=("$dep")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "❌ Error: Dependencias faltantes: ${missing[*]}" >&2
        echo "Por favor, instálalas antes de continuar." >&2
        exit 1
    fi
}

# Ejecutar validación al inicio
